{
  "title": "Zenve Vet Production Platform Observability",
  "timezone": "browser",
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Requests per Second (Throughput)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(zenve_gateway_requests_total[1m])", "legendFormat": "RPS" }
      ]
    },
    {
      "id": 2,
      "title": "Latency Percentiles (p50, p95, p99)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "zenve_gateway_request_duration_ms{quantile=\"0.5\"}", "legendFormat": "p50 (ms)" },
        { "expr": "zenve_gateway_request_duration_ms{quantile=\"0.95\"}", "legendFormat": "p95 (ms)" },
        { "expr": "zenve_gateway_request_duration_ms{quantile=\"0.99\"}", "legendFormat": "p99 (ms)" }
      ]
    },
    {
      "id": 3,
      "title": "HTTP Status Codes Breakdown",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum by (status) (zenve_gateway_requests_by_status)", "legendFormat": "HTTP {{status}}" }
      ]
    },
    {
      "id": 4,
      "title": "Circuit Breaker Status (0=Closed, 1=Half-Open, 2=Open)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        { "expr": "zenve_circuit_breaker_state", "legendFormat": "{{node}}" }
      ]
    },
    {
      "id": 5,
      "title": "Cache Hit vs Miss Ratio",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        { "expr": "zenve_gateway_cache_hits_total", "legendFormat": "Hits" },
        { "expr": "zenve_gateway_cache_misses_total", "legendFormat": "Misses" }
      ]
    }
  ]
}

